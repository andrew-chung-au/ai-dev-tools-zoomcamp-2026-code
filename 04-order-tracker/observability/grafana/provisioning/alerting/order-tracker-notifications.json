{
  "apiVersion": 1,
  "contactPoints": [
    {
      "orgId": 1,
      "name": "Order Tracker responder",
      "receivers": [
        {
          "uid": "order-tracker-responder",
          "type": "webhook",
          "disableResolveMessage": false,
          "settings": {
            "url": "http://host.docker.internal:8001/alerts",
            "httpMethod": "POST",
            "authorization_scheme": "Bearer",
            "authorization_credentials": "${RESPONDER_TOKEN}"
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "empty",
      "group_by": ["grafana_folder", "alertname"],
      "routes": [
        {
          "receiver": "Order Tracker responder",
          "object_matchers": [["owner", "=", "order-tracker-oncall"]],
          "group_by": ["alertname", "endpoint"],
          "group_wait": "30s",
          "group_interval": "5m",
          "repeat_interval": "4h"
        }
      ]
    }
  ]
}
