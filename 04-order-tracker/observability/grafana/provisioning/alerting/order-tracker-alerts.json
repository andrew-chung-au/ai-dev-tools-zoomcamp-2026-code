{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "order-tracker-5xx",
      "folder": "Order Tracker",
      "interval": "30s",
      "rules": [
        {
          "uid": "order-tracker-5xx",
          "title": "Order Tracker 5xx responses",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "datasource": { "type": "prometheus", "uid": "prometheus" },
                "editorMode": "code",
                "expr": "label_replace(label_replace(sum by (http_route, service_name, deployment_environment, service_version) (increase(http_server_request_duration_seconds_count{service_name=\"order-tracker\", http_response_status_code=~\"5..\"}[5m])), \"endpoint\", \"$1\", \"http_route\", \"(.+)\"), \"endpoint\", \"(unmatched)\", \"http_route\", \"\")",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "legendFormat": "{{endpoint}}"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "datasource": { "type": "__expr__", "uid": "__expr__" },
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  { "evaluator": { "type": "gt", "params": [0] } }
                ],
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "1m",
          "isPaused": false,
          "labels": {
            "owner": "order-tracker-oncall",
            "window": "5m"
          },
          "annotations": {
            "summary": "{{ $labels.endpoint }} returned 5xx responses in the last 5 minutes",
            "description": "{{ $labels.service_name }} ({{ $labels.deployment_environment }}, version {{ $labels.service_version }}) returned {{ with $values.A.Value }}about {{ humanize . }} {{ end }}5xx responses on {{ $labels.endpoint }} in the last 5 minutes. Any 5xx fires this alert: users of this endpoint are getting server errors.",
            "dashboard_url": "{{ externalURL }}d/order-tracker-requests"
          }
        }
      ]
    }
  ]
}
