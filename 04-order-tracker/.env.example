# Placeholders only: never commit a real token.
#
# Incident responder (incident-response/responder.py). The responder doesn't read this file:
# export these in the shell that runs `make responder`, or pass them after the target.
# Bind address. Default 127.0.0.1; a non-loopback address requires RESPONDER_TOKEN. To receive
# Grafana's webhook, use the Docker host-gateway address (usually 172.17.0.1, see README).
RESPONDER_HOST=127.0.0.1
# Shared token Grafana sends as "Authorization: Bearer <token>". Required off loopback.
# Grafana gets it too: `make run` passes RESPONDER_TOKEN from the shell, or from a .env file in
# this folder (Compose reads it), into Grafana's container. Unset or empty: deliveries get 401.
# Letters and digits only (for example `openssl rand -hex 32`).
RESPONDER_TOKEN=replace-with-a-long-random-token
