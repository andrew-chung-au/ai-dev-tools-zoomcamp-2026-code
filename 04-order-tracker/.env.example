# Incident responder (incident-response/responder.py). Placeholders only: never commit a real token.
# Bind address. Default 127.0.0.1; a non-loopback address (for example 0.0.0.0) requires RESPONDER_TOKEN.
RESPONDER_HOST=127.0.0.1
# Shared token Grafana sends as "Authorization: Bearer <token>". Required off loopback.
RESPONDER_TOKEN=replace-with-a-long-random-token
