# API base URL for the FastAPI backend
# Used only when the real API service is enabled (default).
VITE_API_BASE_URL=http://localhost:8091/api

# Set to "true" to use the in-browser mock service instead of calling the backend.
# Useful for frontend-only work or when the backend is unavailable.
# Frontend tests always use the mock regardless of this setting.
# VITE_USE_MOCK_SERVICE=true